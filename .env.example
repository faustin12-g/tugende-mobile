# Use a public Mapbox token (pk.*) with styles:read permission.
# Allow the app's local origin in the token's URL restrictions.
VITE_MAPBOX_TOKEN=
# Google Maps JavaScript API + Places API (New); this browser key is public.
VITE_GOOGLE_PLACES_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public web URL used for tracking links shared from the native app build.
VITE_PUBLIC_APP_URL=
